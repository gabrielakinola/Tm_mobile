{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.supportticketmaster.com/api"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801186846",
        "ascApiKeyPath": "./secrets/AuthKey_A477VF626Z.p8",
        "ascApiKeyId": "A477VF626Z",
        "ascApiKeyIssuerId": "6e6932c8-df06-4bcf-8e23-c551587ca22b"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6801186846"
      }
    }
  }
}
